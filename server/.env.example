# Port the API server listens on
PORT=4000

# Comma-separated list of allowed origins for CORS (the deployed frontend URL(s))
CLIENT_ORIGIN=http://localhost:5173

# Resend API key used to email contact form submissions (see src/services/contactService.ts)
# Sign up at https://resend.com, create an API key, and set it here.
# RESEND_API_KEY=

# Address that receives contact form submissions
# CONTACT_TO_EMAIL=you@example.com

# Sender address for outgoing emails. Defaults to Resend's shared sandbox
# address (onboarding@resend.dev), which can only deliver to the email
# address your Resend account was created with. Verify a domain at
# resend.com/domains to send from your own address to any recipient.
# CONTACT_FROM_EMAIL=onboarding@resend.dev
